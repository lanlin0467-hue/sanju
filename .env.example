# 复制本文件为 .env.local,再填入 OpenRouter 密钥。
# 不要把真密钥写进代码或提交到 git。
MODEL_API_KEY=

# 仅在构建 iOS App 时使用；这是公开后端地址，不是模型密钥。
# 设置后重新运行 npm run ios:sync。网页继续请求自身的 /api/generate。
NEXT_PUBLIC_NATIVE_API_BASE_URL=https://sanju-two.vercel.app

# SwiftUI 单进程固定数据夹具仅供本机开发，production 不开放此夹具。
# 本机命令：SANJU_NATIVE_DEV_API=1 FAKE_MODEL=1 npm run dev -- --port 3001
# SANJU_NATIVE_DEV_API=1

# SwiftUI invitation beta: shared PostgreSQL and real model (server only).
# Never set FAKE_MODEL in production. Keep SANJU_BETA_ENABLED off until migration succeeds.
DATABASE_URL=
SANJU_BETA_ENABLED=0
SANJU_BETA_DAILY_MODEL_CALLS=40
SANJU_MODEL_PROVIDER=openrouter
SANJU_MODEL_ID=qwen/qwen3.7-flash
# Optional dedicated model key; OpenRouter can use existing MODEL_API_KEY.
SANJU_MODEL_API_KEY=
# Generate a random secret for the daily data-retention cleanup endpoint.
CRON_SECRET=

# Set to 1 only with a model endpoint supporting Zero Data Retention.
SANJU_REQUIRE_ZDR=0
