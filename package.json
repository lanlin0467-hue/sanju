{
  "name": "sanju",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "try": "node scripts/try-image.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "ios:sync": "npm run build:mobile && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios --configuration Release",
    "ios:build": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build CODE_SIGN_IDENTITY=- build",
    "beta:migrate": "node --env-file-if-exists=.env.beta.local scripts/beta-admin.mjs migrate",
    "beta:invite": "node --env-file-if-exists=.env.beta.local scripts/beta-admin.mjs invite",
    "beta:status": "node --env-file-if-exists=.env.beta.local scripts/beta-admin.mjs status"
  },
  "dependencies": {
    "@capacitor/camera": "8.2.6",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
